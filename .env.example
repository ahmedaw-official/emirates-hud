# ---------------------------------------------------------------------------
# UAE Micro-Mobility Compliance & Safety HUD Engine - environment template
# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. Values shown here are the *runtime* overrides;
# every key is optional because src/config.py ships sensible defaults.

# --- YOLO perception --------------------------------------------------------
YOLO_MODEL_PATH=yolov11n.pt
YOLO_CONFIDENCE_THRESHOLD=0.40
YOLO_IOU_THRESHOLD=0.50

# --- OpenStreetMap / Overpass ----------------------------------------------
OVERPASS_ENDPOINT_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=25

# --- Vision-Language Model --------------------------------------------------
VLM_MODEL_ID=Qwen/Qwen2-VL-2B-Instruct
VLM_MAX_TOKENS=512
VLM_TEMPERATURE=0.2

# --- Resilience / fallbacks -----------------------------------------------
OSM_FALLBACK_ENABLED=true
VLM_FALLBACK_ENABLED=true
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_BASE_SECONDS=0.5

# --- OpenTelemetry ----------------------------------------------------------
OTEL_SERVICE_NAME=uae-scooter-hud-engine
OTEL_RESOURCE_ATTRIBUTES=env=production,region=uae-dubai
OTEL_SAMPLING_RATIO=1.0
# Set OTEL_EXPORTER_OTLP_ENDPOINT to ship spans to a collector, e.g.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORT_CONSOLE=true
OTEL_EXPORT_OTLP=false
OTEL_BSP_SCHEDULE_DELAY_MS=5000

# --- Runtime ----------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
